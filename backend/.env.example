# Copy to .env. Placeholders only - never commit real secrets.
# All timestamps are stored and returned in UTC; TIMEZONE is a display hint only.
DATABASE_URL=sqlite:///./estatepilot.db
SECRET_KEY=replace-with-a-long-random-string
DEMO_MODE=true
SEED_DEMO=true
AI_PROVIDER=demo            # demo | openai | gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/gmail/callback
SENDING_ENABLED=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
POWERBI_EMBED_URL=
POWERBI_REPORT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_EMBED_ENABLED=false
TIMEZONE=UTC
